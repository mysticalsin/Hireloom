# Hireloom web — Supabase config. Copy to .env and fill from your Supabase project
# (Project Settings → API). Only the anon key is exposed to the browser (safe; RLS
# protects the data). Never put the service_role key in this Vite app.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
